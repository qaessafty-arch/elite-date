# ---- Required -------------------------------------------------------------
# PostgreSQL connection string (local Postgres, Supabase, Neon, RDS ...)
DATABASE_URL=postgres://halden:halden@localhost:5432/halden
# Set to "require" for hosted databases that need TLS (Supabase, Neon ...)
DATABASE_SSL=
# Public origin of the site, no trailing slash. Used for SEO, emails, Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Seed accounts (used only by `npm run db:seed`) ------------------------
SEED_ADMIN_EMAIL=admin@halden.test
SEED_ADMIN_PASSWORD=change-me-admin-1
SEED_CUSTOMER_EMAIL=customer@halden.test
SEED_CUSTOMER_PASSWORD=change-me-customer-1

# ---- Payments ---------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys). Leave empty to disable Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Demo payments mark orders as paid without charging anyone. They are always
# available in development. In production they stay OFF unless this is "true"
# (use only for a portfolio/demo deployment, never for a real shop).
PAYMENTS_DEMO_MODE=

# ---- Email ------------------------------------------------------------------
# Resend API key (https://resend.com). Without it, emails are written to
# storage/outbox/ instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Halden <orders@example.com>"

# ---- Local testing ----------------------------------------------------------
# Lets the end-to-end suite register/sign in repeatedly. Ignored in production.
DISABLE_RATE_LIMIT=
